---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { AlertTriangle, DollarSign, RotateCcw, Target } from '@lucide/astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="Scale Without Breaking: The Operating System for Healthy Teams — The Operating Leader" 
			description="Stop losing your best talent to predictable team health issues. The cost of one bad hire is $50,000. The cost of this playbook is $29. Get the proven system now." 
		/>
	</head>
	<body>
		<Header />
		<main class="playbook-page">
			<!-- Hero -->
			<section class="hero">
				<p class="eyebrow">The $140,000 surprise most leaders never see coming</p>
				<h1>Scale Without Breaking:<br/>The Operating System for Healthy Teams</h1>
				<p class="subtitle">
					Stop losing your best talent to predictable (but invisible) team health issues. 
					Your people are planning their exit. The warning signs are there, but you don't know how to read them.
				</p>
				<div class="roi-highlight">
					<span class="problem-cost">The cost of one bad hire: $50,000</span>
					<span class="solution-cost">The cost of this system: $29</span>
				</div>
				<a href="#buy" class="cta-button buy-btn" onclick="handleCheckout(event)">Get the Proven System — $29</a>
				<p class="cta-sub">Instant access · Implement in 5 days · Results immediately</p>
			</section>

			<!-- Problem Amplification -->
			<section class="section problem-section">
				<h2>The invisible signals your team is breaking down</h2>
				<div class="warning-grid">
					<div class="warning-item">
						<span class="warning-icon"><AlertTriangle size="24" /></span>
						<h3>Meetings are quieter than they should be</h3>
						<p>The spark is fading. Ideas aren't flowing. Your people show up but don't speak up.</p>
					</div>
					<div class="warning-item">
						<span class="warning-icon"><DollarSign size="24" /></span>
						<h3>Good people leave with no warning</h3>
						<p>$140K+ to replace a mid-level employee. Plus the knowledge, relationships, and momentum they take with them.</p>
					</div>
					<div class="warning-item">
						<span class="warning-icon"><RotateCcw size="24" /></span>
						<h3>Everyone's busy but nothing moves</h3>
						<p>The hamster wheel spins faster, but progress slows. Energy high, output low.</p>
					</div>
					<div class="warning-item">
						<span class="warning-icon"><Target size="24" /></span>
						<h3>Conflicts escalate before resolution</h3>
						<p>By the time it surfaces, the damage is done. Trust eroded, alignments broken.</p>
					</div>
				</div>
				<div class="problem-summary">
					<p><strong>78% of disengaged employees are invisible to leadership.</strong> You feel it, but can't name it. This system gives you the words — and the solution.</p>
				</div>
			</section>

			<!-- Solution Framework -->
			<section class="section" id="cetag-framework">
				<h2>The 5 Invisible Signals (CETAG Framework)</h2>
				<p class="framework-intro">Every team breakdown traces back to one of these five dimensions. When they crack, everything else follows.</p>
				<div class="cetag-grid">
					<div class="cetag-item">
						<h3><span class="cetag-letter">C</span>larity</h3>
						<p>Does everyone know what success looks like? Or are they guessing?</p>
					</div>
					<div class="cetag-item">
						<h3><span class="cetag-letter">E</span>nergy</h3>
						<p>Are people energized by the work? Or just going through the motions?</p>
					</div>
					<div class="cetag-item">
						<h3><span class="cetag-letter">T</span>rust</h3>
						<p>Can people speak truth to power? Or do they tell you what you want to hear?</p>
					</div>
					<div class="cetag-item">
						<h3><span class="cetag-letter">A</span>lignment</h3>
						<p>Is everyone pulling in the same direction? Or optimizing for their own goals?</p>
					</div>
					<div class="cetag-item">
						<h3><span class="cetag-letter">G</span>rowth</h3>
						<p>Are people developing new capabilities? Or stagnating in their comfort zone?</p>
					</div>
				</div>
			</section>

			<!-- What's Inside -->
			<section class="section">
				<h2>Your 5-Day Implementation System</h2>
				<div class="toc">
					<div class="toc-item">
						<span class="toc-part">Day 1</span>
						<h3>Diagnostic Questions That Reveal Everything</h3>
						<p>40+ copy-paste questions for 1:1s and team settings. The exact words that make people tell you the truth.</p>
					</div>
					<div class="toc-item">
						<span class="toc-part">Day 2-3</span>
						<h3>Early Warning System Setup</h3>
						<p>The 2-minute weekly pulse that spots problems 3-6 weeks before they explode. No expensive tools required.</p>
					</div>
					<div class="toc-item">
						<span class="toc-part">Day 4</span>
						<h3>Action Playbooks for Common Breakdowns</h3>
						<p>The Silent Team. The Hamster Wheel. The Revolving Door. Week-by-week fixes that actually work.</p>
					</div>
					<div class="toc-item">
						<span class="toc-part">Day 5</span>
						<h3>Your Monday Morning Ritual</h3>
						<p>The 10-minute review that keeps you ahead of problems. Make it automatic, make it stick.</p>
					</div>
				</div>
			</section>

			<!-- Social Proof -->
			<section class="section proof-section">
				<h2>Distilled from 20 years of getting it right — and wrong</h2>
				<div class="author-story">
					<div class="story-timeline">
						<div class="story-point">
							<span class="story-stage">4 people, 12m² office</span>
							<p>Mailigen started small. Every conversation mattered. Every signal was visible.</p>
						</div>
						<div class="story-arrow">→</div>
						<div class="story-point">
							<span class="story-stage">15 people: First breakdown</span>
							<p>Suddenly, I couldn't feel the pulse anymore. People stopped speaking up. Productivity dropped.</p>
						</div>
						<div class="story-arrow">→</div>
						<div class="story-point">
							<span class="story-stage">40 people: System built</span>
							<p>Created the framework that prevented surprises. Sold for millions without losing key talent.</p>
						</div>
						<div class="story-arrow">→</div>
						<div class="story-point">
							<span class="story-stage">700 people: PE transition</span>
							<p>At Pipedrive, navigated organizational change that breaks most teams. The system scaled.</p>
						</div>
					</div>
					<p class="story-conclusion">This isn't theory from a consulting deck. It's the specific questions, signals, and actions from two decades of scaling teams without breaking them.</p>
				</div>
			</section>

			<!-- Buy -->
			<section class="section buy-section" id="buy">
				<div class="buy-box">
					<div class="urgency-header">
						<p class="urgency-text">The cost of waiting: $140K+ per resignation you didn't see coming</p>
					</div>
					<h2>Get the Complete Operating System</h2>
					<div class="price-comparison">
						<span class="old-approach">Expensive consultants: $15,000+</span>
						<span class="new-approach">This proven system: $29</span>
					</div>
					<ul class="buy-includes">
						<li>✓ 40+ diagnostic questions — copy-paste ready for immediate use</li>
						<li>✓ 5-day implementation guide — see results this week</li>
						<li>✓ 3 action playbooks for the most common team breakdowns</li>
						<li>✓ Weekly pulse framework that replaces expensive tools</li>
						<li>✓ Early warning system — spot problems 3-6 weeks early</li>
					</ul>
					<a href="#buy" class="cta-button buy-btn" onclick="handleCheckout(event)">Get the Proven System — $29</a>
					<p class="guarantee">30-day team improvement guarantee. Implement in 1 week or full refund.</p>
				</div>
			</section>

			<!-- FAQ -->
			<section class="section">
				<h2>Questions from leaders like you</h2>
				<div class="faq">
					<div class="faq-item">
						<h3>How is this different from employee engagement surveys?</h3>
						<p>Surveys tell you what happened. This system tells you what's about to happen. It's predictive, not reactive. And it takes 2 minutes, not 2 weeks.</p>
					</div>
					<div class="faq-item">
						<h3>I'm already overwhelmed. Will this add to my workload?</h3>
						<p>This reduces your workload by preventing fires instead of fighting them. 10 minutes on Monday beats 10 hours dealing with a resignation crisis.</p>
					</div>
					<div class="faq-item">
						<h3>My team is too small for formal processes.</h3>
						<p>This is designed for scaling teams (10-50 people). If you feel like you're losing the pulse, you're the exact right size.</p>
					</div>
					<div class="faq-item">
						<h3>What if my team doesn't respond honestly?</h3>
						<p>The framework includes specific techniques for creating psychological safety and getting real feedback. That's half the battle.</p>
					</div>
				</div>
			</section>

			<!-- Final CTA -->
			<section class="section final-cta">
				<div class="final-message">
					<p class="final-stat">Most leaders don't measure team health at all.</p>
					<p class="final-insight">You don't need to be perfect. You just need to be intentional.</p>
					<p class="final-promise">Get ahead of the problems that blindside other leaders.</p>
				</div>
				<a href="#buy" class="cta-button buy-btn" onclick="handleCheckout(event)">Get the Operating System — $29</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.playbook-page {
		width: 100% !important;
		max-width: 720px !important;
		margin: 0 auto;
		padding: 2em 1em 4em;
		overflow-x: hidden;
		word-wrap: break-word;
		box-sizing: border-box;
	}

	/* Hero with ROI focus */
	.hero {
		text-align: center;
		padding: 3em 0 3em;
		border-bottom: 1px solid var(--border);
	}
	.eyebrow {
		text-transform: uppercase;
		font-size: 0.85em;
		letter-spacing: 0.1em;
		color: #ff6b6b;
		font-weight: 600;
		margin-bottom: 1em;
	}
	.hero h1 {
		font-size: 3.2em;
		line-height: 1.1;
		letter-spacing: -0.04em;
		margin-bottom: 0.5em;
	}
	.subtitle {
		font-size: 1.15em;
		color: var(--text-muted);
		line-height: 1.7;
		max-width: 560px;
		margin: 0 auto 2em;
	}
	
	.roi-highlight {
		background: linear-gradient(135deg, rgba(255, 107, 107, 0.1) 0%, rgba(201, 165, 90, 0.1) 100%);
		border: 1px solid var(--border);
		border-radius: 12px;
		padding: 1.5em;
		margin: 2em auto;
		max-width: 480px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1em;
	}
	.problem-cost {
		color: #ff6b6b;
		font-weight: 600;
		font-size: 1.1em;
	}
	.solution-cost {
		color: var(--accent);
		font-weight: 600;
		font-size: 1.1em;
	}
	
	.cta-button {
		display: inline-block;
		background: var(--accent);
		color: var(--bg) !important;
		padding: 1em 2.5em;
		border-radius: 8px;
		font-weight: 600;
		font-size: 1.1em;
		text-decoration: none !important;
		transition: all 0.2s ease;
		box-sizing: border-box;
		max-width: 100%;
	}
	.cta-button:hover {
		background: var(--accent-hover);
		transform: translateY(-1px);
	}
	.cta-sub {
		font-size: 0.85em;
		color: var(--text-muted);
		margin-top: 1em;
	}

	/* Problem section */
	.problem-section {
		background: rgba(255, 107, 107, 0.03);
		border-radius: 12px;
		padding: 3em 2em;
		margin: 3em 0;
	}
	.warning-grid {
		display: grid;
		gap: 1.5em;
		margin: 2em 0;
	}
	.warning-item {
		display: flex;
		align-items: flex-start;
		gap: 1em;
		padding: 1.5em;
		background: var(--bg-raised);
		border-radius: 8px;
		border-left: 4px solid #ff6b6b;
	}
	.warning-icon {
		flex-shrink: 0;
		color: #ff6b6b;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.5em;
		background: rgba(255, 107, 107, 0.1);
		border-radius: 6px;
	}
	.warning-item h3 {
		margin: 0 0 0.5em;
		color: var(--text);
		font-size: 1.05em;
	}
	.warning-item p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.95em;
	}
	.problem-summary {
		background: var(--bg-raised);
		padding: 1.5em;
		border-radius: 8px;
		margin-top: 2em;
		text-align: center;
	}
	.problem-summary strong {
		color: var(--accent);
	}

	/* CETAG Framework */
	.framework-intro {
		font-size: 1.1em;
		color: var(--text-muted);
		text-align: center;
		margin: 1em 0 2em;
	}
	.cetag-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5em;
		margin: 2em 0;
	}
	.cetag-item {
		padding: 1.5em;
		background: var(--bg-raised);
		border-radius: 8px;
		border: 1px solid var(--border);
		text-align: center;
	}
	.cetag-letter {
		font-size: 2em;
		color: var(--accent);
		font-weight: 700;
	}
	.cetag-item h3 {
		margin: 0.5em 0;
		font-size: 1.25em;
	}
	.cetag-item p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.95em;
	}

	/* Social proof story */
	.proof-section {
		background: rgba(201, 165, 90, 0.05);
		border-radius: 12px;
		padding: 3em 2em;
		margin: 3em 0;
	}
	.proof-section h2 {
		margin-bottom: 1.5em;
		line-height: 1.2;
	}
	.story-timeline {
		display: flex;
		align-items: stretch;
		gap: 0.5em;
		margin: 2em 0;
		flex-wrap: wrap;
	}
	.story-point {
		flex: 1;
		min-width: 140px;
		text-align: center;
		padding: 1.5em 1em;
		background: var(--bg-raised);
		border-radius: 8px;
		border: 1px solid var(--border);
		display: flex;
		flex-direction: column;
		justify-content: center;
	}
	.story-stage {
		display: block;
		font-weight: 600;
		color: var(--accent);
		margin-bottom: 0.75em;
		font-size: 0.9em;
		line-height: 1.3;
	}
	.story-point p {
		font-size: 0.9em;
		color: var(--text-muted);
		margin: 0;
		line-height: 1.4;
	}
	.story-arrow {
		flex: 0 0 auto;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--accent);
		font-size: 1.2em;
		font-weight: bold;
		padding: 0 0.5em;
		opacity: 0.6;
	}
	.story-conclusion {
		font-size: 1.1em;
		font-style: italic;
		text-align: center;
		margin-top: 2em;
	}

	/* Enhanced buy section */
	.buy-section {
		border-bottom: none;
	}
	.buy-box {
		text-align: center;
		background: var(--bg-raised);
		padding: 3em 2em;
		border-radius: 12px;
		border: 2px solid var(--border);
		overflow: hidden;
		box-sizing: border-box;
	}
	.urgency-header {
		background: rgba(255, 107, 107, 0.1);
		margin: -3em -2em 2em;
		padding: 1em 2em;
	}
	.urgency-text {
		font-size: 0.9em;
		color: #ff6b6b;
		font-weight: 600;
		margin: 0;
	}
	.price-comparison {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 2em;
		margin: 1.5em 0;
		flex-wrap: wrap;
	}
	.old-approach {
		color: var(--text-faint);
		text-decoration: line-through;
		font-size: 0.9em;
	}
	.new-approach {
		font-size: 2.5em;
		font-weight: 700;
		color: var(--accent);
	}
	.guarantee {
		font-size: 0.9em;
		color: var(--accent);
		margin-top: 1em;
		font-weight: 600;
	}

	/* Sections */
	.section {
		padding: 3em 0;
		border-bottom: 1px solid var(--border);
	}
	.section h2 {
		font-size: 1.75em;
		margin-bottom: 1em;
		letter-spacing: -0.03em;
	}

	/* TOC */
	.toc {
		display: grid;
		gap: 1.5em;
		margin-top: 1.5em;
	}
	.toc-item {
		padding: 1.5em;
		background: var(--bg-raised);
		border: 1px solid var(--border);
		border-radius: 8px;
	}
	.toc-part {
		font-size: 0.75em;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--accent);
		font-weight: 600;
	}
	.toc-item h3 {
		font-size: 1.15em;
		margin: 0.25em 0 0.5em;
	}
	.toc-item p {
		font-size: 0.92em;
		margin: 0;
		color: var(--text-muted);
	}

	/* FAQ */
	.faq {
		margin-top: 1em;
	}
	.faq-item {
		padding: 1.25em 0;
		border-bottom: 1px solid var(--border);
	}
	.faq-item:last-child {
		border-bottom: none;
	}
	.faq-item h3 {
		font-size: 1.05em;
		margin-bottom: 0.5em;
	}
	.faq-item p {
		font-size: 0.95em;
		color: var(--text-muted);
		margin: 0;
	}

	/* Final CTA */
	.final-cta {
		text-align: center;
		border-bottom: none;
		padding-bottom: 2em;
	}
	.final-message {
		margin-bottom: 2em;
	}
	.final-stat {
		font-size: 1.2em;
		color: var(--text-muted);
		margin-bottom: 0.5em;
	}
	.final-insight {
		font-size: 1.1em;
		color: var(--text);
		margin-bottom: 0.5em;
	}
	.final-promise {
		font-size: 1.1em;
		color: var(--accent);
		font-weight: 600;
		margin-bottom: 0;
	}

	/* Buy includes */
	.buy-includes {
		list-style: none;
		padding: 0;
		text-align: left;
		max-width: 400px;
		margin: 2em auto;
	}
	.buy-includes li {
		padding: 0.4em 0;
		color: var(--text-muted);
	}

	/* Mobile responsive */
	@media (max-width: 720px) {
		.playbook-page { padding: 1em 1em 3em; }
		.hero { padding: 2em 0; }
		.hero h1 { font-size: 2em; }
		.subtitle { font-size: 1em; }
		.roi-highlight { flex-direction: column; text-align: center; }
		.price-comparison { flex-direction: column; gap: 1em; }
		.new-approach { font-size: 2em; }
		.story-timeline { 
			flex-direction: column; 
			gap: 1em;
		}
		.story-arrow { display: none; }
		.story-point {
			min-width: unset;
		}
		.warning-grid { gap: 1em; }
		.warning-item { flex-direction: column; text-align: center; }
		.cetag-grid { grid-template-columns: 1fr; }
		.section { padding: 2em 0; }
		.section h2 { font-size: 1.4em; }
		.buy-box { padding: 2em 1.25em; }
		.urgency-header { margin: -2em -1.25em 1.5em; }
		.cta-button { padding: 0.8em 1.5em; font-size: 1em; display: block; width: 100%; text-align: center; box-sizing: border-box; }
	}

	@media (max-width: 480px) {
		.hero h1 { font-size: 1.6em; }
		.section h2 { font-size: 1.25em; }
		.subtitle { font-size: 0.95em; }
		.final-message p { font-size: 1em; }
	}

	.buy-btn.loading {
		opacity: 0.6;
		pointer-events: none;
	}
</style>

<script is:inline>
async function handleCheckout(e) {
	e.preventDefault();
	const btn = e.target;
	const originalText = btn.textContent;
	btn.textContent = 'Redirecting to checkout...';
	btn.classList.add('loading');
	try {
		const res = await fetch('https://operatingleader-checkout.rozenblats.workers.dev/create-checkout', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
		});
		const data = await res.json();
		if (data.url) {
			window.location.href = data.url;
		} else {
			alert('Checkout is being set up. Please try again shortly.');
			btn.textContent = originalText;
			btn.classList.remove('loading');
		}
	} catch (err) {
		alert('Checkout is being set up. Please try again shortly.');
		btn.textContent = originalText;
		btn.classList.remove('loading');
	}
}
</script>

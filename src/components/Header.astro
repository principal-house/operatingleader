---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a href="/" class="logo"><img src="/images/ol-logo.png" alt="The Operating Leader" class="logo-img" /> The Operating Leader</a>
		<input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Toggle navigation" />
		<label for="nav-toggle" class="nav-toggle-label" aria-label="Open navigation menu">
			<span></span>
			<span></span>
			<span></span>
		</label>
		<div class="nav-links">
			<HeaderLink href="/blog">Articles</HeaderLink>
			<HeaderLink href="/playbook">Playbook</HeaderLink>
			<HeaderLink href="/subscribe">Subscribe</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<a href="https://www.linkedin.com/in/janisr/" target="_blank" aria-label="LinkedIn" class="social">
				<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
			</a>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(10, 10, 10, 0.85);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}
	nav {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 720px;
		margin: 0 auto;
		padding: 0 1em;
		height: 56px;
	}
	.logo {
		font-size: 0.95em;
		font-weight: 700;
		color: var(--text);
		text-decoration: none;
		letter-spacing: -0.02em;
		display: flex;
		align-items: center;
		gap: 0.5em;
		z-index: 102;
	}
	.logo-img { width: 28px; height: 28px; border-radius: 4px; }
	.logo:hover { color: var(--accent); }
	.nav-toggle {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}
	.nav-toggle-label {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 4px;
		width: 40px;
		height: 40px;
		cursor: pointer;
		z-index: 102;
	}
	.nav-toggle-label span {
		display: block;
		width: 20px;
		height: 2px;
		margin-left: auto;
		background: var(--text);
		border-radius: 999px;
		transition: transform 0.2s ease, opacity 0.2s ease;
	}
	.nav-links {
		display: flex;
		align-items: center;
		gap: 1.5em;
	}
	.nav-links a {
		font-size: 0.88em;
		color: var(--text-muted);
		text-decoration: none;
		font-weight: 500;
		transition: color 0.15s ease;
	}
	.nav-links a:hover, .nav-links a.active {
		color: var(--text);
	}
	.social { display: flex; align-items: center; }

	@media (max-width: 760px) {
		nav {
			height: auto;
			min-height: 56px;
			padding-top: 0.5em;
			padding-bottom: 0.5em;
			flex-wrap: wrap;
		}
		.nav-toggle-label {
			display: flex;
		}
		.nav-links {
			display: none;
			width: 100%;
			flex-direction: column;
			align-items: flex-start;
			gap: 0;
			padding: 0.75em 0 0.25em;
		}
		.nav-links :global(a) {
			width: 100%;
			padding: 0.8em 0;
			border-top: 1px solid var(--border);
		}
		.nav-links .social {
			justify-content: flex-start;
		}
		.nav-toggle:checked ~ .nav-links {
			display: flex;
		}
		.nav-toggle:checked + .nav-toggle-label span:nth-child(1) {
			transform: translateY(6px) rotate(45deg);
		}
		.nav-toggle:checked + .nav-toggle-label span:nth-child(2) {
			opacity: 0;
		}
		.nav-toggle:checked + .nav-toggle-label span:nth-child(3) {
			transform: translateY(-6px) rotate(-45deg);
		}
	}

	@media (min-width: 761px) {
		.nav-links {
			display: flex !important;
		}
	}
</style>
